---
import { sections } from '../data/site';
import { withBase } from '../lib/url';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="页面不存在"
  description="这个地址没有对应的页面。"
  noindex={true}
  canonicalPath="/404/"
>
  <div class="notfound">
    <div class="container container--narrow">
      <p class="code">404</p>
      <h1 class="title">这个地址没有页面</h1>
      <p class="desc">
        可能是链接写错了，也可能是这篇文章的地址变过。
        从下面这些入口重新找一下：
      </p>

      <ul class="links">
        <li><a href={withBase('/')}>首页</a></li>
        {
          Object.values(sections).map((s) => (
            <li><a href={withBase(s.path)}>{s.name}</a></li>
          ))
        }
        <li><a href={withBase('/archive/')}>全部归档</a></li>
        <li><a href={withBase('/community/')}>社群</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding: var(--s-9) 0;
  }

  .code {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--brand);
  }

  .title {
    margin-top: var(--s-2);
    font-size: 28px;
  }

  .desc {
    margin-top: var(--s-3);
    font-size: 15.5px;
    line-height: 1.8;
    color: var(--text-2);
  }

  .links {
    margin-top: var(--s-5);
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .links a {
    display: inline-block;
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--line-1);
    border-radius: var(--r-pill);
    background: var(--surface);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }

  .links a:hover {
    border-color: var(--navy);
    color: var(--navy);
    text-decoration: none;
  }
</style>
