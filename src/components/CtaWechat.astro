---
import fs from 'node:fs';
import path from 'node:path';

import { cta, wechat } from '../data/site';
import { assetUrl } from '../lib/url';

/**
 * 全站唯一 CTA —— 只用公众号二维码。
 *
 * 为什么不放微信群二维码：微信群码 7 天失效，静态页放死码等于把转化路径静默切断。
 * 群码只在 /community/ 出现一次，且超期会由构建期自动隐藏。
 *
 * 文案全部来自 site.ts，组件内不写任何时间字符串
 * （全站禁止承诺具体推送时点，见交付方案 §5）。
 */

interface Props {
  /** compact：文章文末用，视觉弱一档 */
  variant?: 'block' | 'compact';
}

const { variant = 'block' } = Astro.props;

const qrPath = path.join(process.cwd(), 'public', wechat.qrImage.replace(/^\//, ''));
const hasQrImage = fs.existsSync(qrPath);
---

<section class:list={['cta', `cta--${variant}`]} aria-labelledby="cta-title">
  <div class="cta-text">
    <h2 class="cta-title" id="cta-title">{cta.main.title}</h2>
    <p class="cta-body">{cta.main.body}</p>
    <p class="cta-sub">{cta.sub.body}</p>
  </div>

  <div class="cta-qr">
    {
      hasQrImage ? (
        <img
          src={assetUrl(wechat.qrImage)}
          alt={wechat.qrAlt}
          width="132"
          height="132"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="qr-placeholder" role="img" aria-label="公众号二维码（待上传）">
          <span>二维码</span>
          <span>待上传</span>
        </div>
      )
    }
    <p class="qr-hint">{wechat.name}</p>
  </div>
</section>

<style>
  .cta {
    display: grid;
    gap: var(--s-5);
    background: var(--ink-900);
    color: var(--ink-text);
    border-radius: var(--r-lg);
    padding: var(--s-6) var(--s-5);
  }

  .cta-title {
    font-size: var(--fs-h2);
    color: #fff;
  }

  .cta-body {
    margin-top: var(--s-3);
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--ink-text-2);
  }

  .cta-sub {
    margin-top: var(--s-3);
    font-size: var(--fs-sm);
    line-height: 1.7;
    color: var(--ink-text-3);
  }

  .cta-qr {
    display: grid;
    justify-items: center;
    gap: var(--s-2);
  }

  .cta-qr img {
    /* 公众号后台导出的图静默区偏窄（约 2 个模块，规范要 4 个），
       这里用白色 padding 补足，比改源图安全，也比扫描失败便宜。 */
    width: 132px;
    height: 132px;
    border-radius: var(--r-sm);
    background: #fff;
    padding: 12px;
  }

  .qr-placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 2px;
    width: 132px;
    height: 132px;
    border: 1px dashed rgba(255, 255, 255, 0.35);
    border-radius: var(--r-sm);
    font-size: var(--fs-xs);
    color: var(--ink-text-3);
  }

  .qr-hint {
    font-size: var(--fs-xs);
    color: var(--ink-text-3);
  }

  /* 文末 CTA 弱一档：浅底 + 细边，不抢正文结尾的注意力 */
  .cta--compact {
    background: var(--surface);
    color: var(--text-1);
    border: 1px solid var(--line-1);
    padding: var(--s-5);
    margin-top: var(--s-6);
  }

  .cta--compact .cta-title {
    color: var(--text-1);
    font-size: var(--fs-h3);
  }

  .cta--compact .cta-body {
    color: var(--text-2);
    font-size: var(--fs-sm);
  }

  .cta--compact .cta-sub {
    color: var(--text-3);
    font-size: var(--fs-xs);
  }

  .cta--compact .qr-placeholder {
    border-color: var(--line-2);
    color: var(--text-3);
  }

  .cta--compact .qr-hint {
    color: var(--text-3);
  }

  @media (min-width: 600px) {
    .cta {
      grid-template-columns: 1fr auto;
      align-items: center;
      padding: var(--s-6);
    }
  }
</style>
