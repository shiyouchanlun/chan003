---
import type { MarkdownHeading } from 'astro';

/**
 * 文章目录。纯 CSS + <details>，零 JS。
 * 移动端默认折叠（details 天然如此），桌面端也不强行展开——
 * 短文章不该被目录占掉首屏。
 */

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length >= 3 && (
    <details class="toc">
      <summary>
        <span>本文目录</span>
        <span class="toc-count">{items.length} 节</span>
      </summary>
      <nav aria-label="文章目录">
        <ol>
          {items.map((h) => (
            <li class:list={[{ 'toc-h3': h.depth === 3 }]}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}

<style>
  .toc {
    background: var(--surface-2);
    border: 1px solid var(--line-1);
    border-radius: var(--r-md);
    padding: var(--s-3) var(--s-4);
    margin-bottom: var(--s-5);
    font-size: var(--fs-sm);
  }

  summary {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    cursor: pointer;
    color: var(--text-2);
    font-weight: 600;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '展开';
    margin-left: auto;
    font-size: var(--fs-xs);
    font-weight: 400;
    color: var(--text-3);
  }

  details[open] summary::after {
    content: '收起';
  }

  details[open] summary {
    margin-bottom: var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--line-1);
  }

  .toc-count {
    font-size: var(--fs-xs);
    font-weight: 400;
    color: var(--text-3);
  }

  ol {
    list-style: none;
    display: grid;
    gap: 6px;
    counter-reset: toc;
  }

  li {
    counter-increment: toc;
    line-height: 1.6;
  }

  li a {
    color: var(--text-2);
  }

  li a:hover {
    color: var(--navy);
  }

  .toc-h3 {
    padding-left: var(--s-4);
    font-size: var(--fs-xs);
  }
</style>
